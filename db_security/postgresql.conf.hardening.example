# =============================================================================
# postgresql.conf hardening snippets (append / merge, then reload or restart)
# =============================================================================

# --- Authentication ---
password_encryption = scram-sha-256

# --- Connection / logging ---
log_connections = on
log_disconnections = on
log_hostname = on
log_line_prefix = '%m [%p] %q%u@%d %h '
log_min_duration_statement = 1000   # log slow queries (>= 1s); tune as needed

# Failed auth / errors
log_statement = 'ddl'               # always log schema changes (DDL)
# For fuller DML audit use pgaudit below instead of log_statement = 'all'

# --- Listen (bind only to private interfaces when possible) ---
# listen_addresses = '172.18.7.86'  # example: DB host LAN IP, not '*'

# --- pgaudit (install extension first — see pgaudit_setup.sql) ---
# This server already uses TimescaleDB; preserve it when adding pgAudit.
# shared_preload_libraries = 'timescaledb,pgaudit'   # requires restart
# pgaudit.log = 'ddl, write, role'
# pgaudit.log_catalog = off
# pgaudit.log_parameter = on
# pgaudit.log_relation = on

# After editing:
#   SELECT pg_reload_conf();
# Changes to shared_preload_libraries require a full PostgreSQL restart.
